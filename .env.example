APP_MODE=preview
DATABASE_URL=postgresql://vfl_login:replace-in-secret-manager@localhost:5432/vfl
# Use the Supabase transaction-pooler URL for runtime; add pgbouncer=true if required by Prisma.
# Prisma migrations use a direct or session-pooler connection, never the transaction pooler.
DIRECT_URL=postgresql://vfl_owner:replace-in-secret-manager@localhost:5432/vfl
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_URL=http://127.0.0.1:3000
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/YOUR-TENANT-ID/v2.0
Z_SOURCE_VERSION=ISO8655-6:2022-TableA1-transcribed-UNVERIFIED
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=vfl-certificates
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CERTIFICATE_TEMPLATE_APPROVED=false
CERTIFICATE_LOGO_URL=
CERTIFICATE_FOOTER=