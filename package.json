    "csv-parse": "6.1.0",
    "date-fns": "4.1.0",
    "decimal.js": "10.6.0",
    "lucide-react": "0.548.0",
    "next": "15.5.29",
    "next-auth": "5.0.0-beta.32",
    "pino": "10.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.65.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "@testcontainers/postgresql": "12.2.1",
