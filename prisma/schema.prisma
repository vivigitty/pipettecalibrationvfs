generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum ChannelType {
  single
  eight
  twelve
  @@map("channel_type")
}
enum ServiceMode {
  onsite
  offsite
  @@map("service_mode")
}
enum AssetProgress {
  not_started
  in_progress
  completed
  @@map("asset_progress")
}
enum SessionStatus {
  in_progress
  completed
  abandoned
  @@map("session_status")
}
enum ResultStatus {
  pending
  pass
  fail
  @@map("result_status")
}
enum UserRole {
  technician
  admin
  executive
  @@map("user_role")
}
enum InstrumentType {
  balance
  air_thermometer
  water_thermometer
  @@map("instrument_type")
}
model User {
  customers Customer[]
  limits RangeThresholdLimit[]
  assets Asset[]
  labs LabDimension[]
  sessions CalibrationSession[]
  damages AssetDamage[]
  generatedCertificates AssetCertification[] @relation("CertificateGenerator")
  voidedCertificates AssetCertification[] @relation("CertificateVoider")
  audits AuditLog[]
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email String @unique @db.Citext
  displayName String @map("display_name") @db.VarChar(120)
  role UserRole
  externalSubject String @unique @map("external_subject") @db.VarChar(255)
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  @@map("users")
}
model Customer {
  creator User @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assets Asset[]
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerName String @map("customer_name") @db.VarChar(200)
  department String @db.VarChar(150)
  address1 String @map("address_1") @db.VarChar(250)
  address2 String? @map("address_2") @db.VarChar(250)
  email String @db.Citext
  phone1 String @map("phone_1") @db.VarChar(30)
  phone2 String? @map("phone_2") @db.VarChar(30)
  contactName String @map("contact_name") @db.VarChar(150)
  isActive Boolean @default(true) @map("is_active")
  createdBy String @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  @@map("customers")
}
model RangeThreshold {
  assets Asset[]
  limits RangeThresholdLimit[]
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rangeLabel String @map("range_label") @db.VarChar(30)
  rangeMinUl Decimal? @map("range_min_ul") @db.Decimal
  rangeMaxUl Decimal @map("range_max_ul") @db.Decimal
  channel ChannelType
  channelCount Int @map("channel_count") @db.SmallInt
  make String @db.VarChar(100)
  model String @db.VarChar(100)
  timesToTest Int @map("times_to_test") @db.SmallInt
  repeats Int @db.SmallInt
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  @@unique([rangeLabel,channel,make,model], map: "uq_range_configuration")
  @@map("range_thresholds")
}
model RangeThresholdLimit {
  range RangeThreshold @relation(fields: [rangeThresholdId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  capturer User @relation(fields: [capturedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  volumes CalibrationVolumeResult[]
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rangeThresholdId String @map("range_threshold_id") @db.Uuid
  testPointPct Int @map("test_point_pct") @db.SmallInt
  nominalVolumeUl Decimal @map("nominal_volume_ul") @db.Decimal
  inaccuracyLimitPct Decimal @map("inaccuracy_limit_pct") @db.Decimal
  imprecisionLimitPct Decimal @map("imprecision_limit_pct") @db.Decimal
  capturedBy String @map("captured_by") @db.Uuid
  capturedAt DateTime @default(now()) @map("captured_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  @@unique([rangeThresholdId,nominalVolumeUl], map: "uq_limit_volume")
  @@unique([rangeThresholdId,testPointPct], map: "uq_limit_point")
  @@unique([id,nominalVolumeUl], map: "uq_limit_id_volume")
  @@index([rangeThresholdId], map: "ix_limits_range")
  @@map("range_threshold_limits")
}
model Instrument {
  balanceLabs LabDimension[] @relation("LabBalance")
  airLabs LabDimension[] @relation("LabAir")
  waterLabs LabDimension[] @relation("LabWater")
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  instrumentType InstrumentType @map("instrument_type")
  makeModel String @map("make_model") @db.VarChar(150)
  serialNumber String @map("serial_number") @db.VarChar(100)
  calibrationDueDate DateTime @map("calibration_due_date") @db.Date
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  @@unique([serialNumber,instrumentType,calibrationDueDate], map: "uq_instrument_version")
  @@map("instruments")
}
model Asset {
  sessions CalibrationSession[]
  customer Customer @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  range RangeThreshold @relation(fields: [rangeThresholdId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator User @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  damages AssetDamage[]
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String @map("customer_id") @db.Uuid
  rangeThresholdId String @map("range_threshold_id") @db.Uuid
  serialNumber String @map("serial_number") @db.VarChar(100)
  inventoryNumber String @unique @map("inventory_number") @db.VarChar(100)
  customerAssetId String? @map("customer_asset_id") @db.VarChar(100)
  invoiceNumber String @map("invoice_number") @db.VarChar(100)
  progress AssetProgress @default(not_started)
  createdBy String @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  @@unique([id,customerId,rangeThresholdId], map: "uq_asset_ancestry")
  @@index([customerId,progress], map: "ix_assets_customer_progress")
  @@index([customerId,serialNumber], map: "ix_assets_customer_serial")
  @@index([rangeThresholdId], map: "ix_assets_range")
  @@map("assets")
}
model ZFactorReference {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  temperatureC Decimal @map("temperature_c") @db.Decimal
  pressureKpa Decimal @map("pressure_kpa") @db.Decimal
  zValue Decimal @map("z_value") @db.Decimal(6,4)
  sourceVersion String @map("source_version") @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  @@unique([temperatureC,pressureKpa,sourceVersion], map: "uq_z_grid")
  @@map("z_factor_references")
}
model LabDimension {
  calibrator User @relation(fields: [calibratedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  balance Instrument @relation("LabBalance", fields: [balanceInstrumentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  air Instrument @relation("LabAir", fields: [airInstrumentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  water Instrument @relation("LabWater", fields: [waterThermometerInstrumentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sessions CalibrationSession[]
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  processDate DateTime @default(dbgenerated("CURRENT_DATE")) @map("process_date") @db.Date
  serviceMode ServiceMode @default(onsite) @map("service_mode")
  calibratedByUserId String @map("calibrated_by_user_id") @db.Uuid
  balanceInstrumentId String @map("balance_instrument_id") @db.Uuid
  airInstrumentId String @map("air_instrument_id") @db.Uuid
  waterThermometerInstrumentId String @map("water_thermometer_instrument_id") @db.Uuid
  ddWaterTempC Decimal @map("dd_water_temp_c") @db.Decimal
  roomTempC Decimal @map("room_temp_c") @db.Decimal
  humidityPct Decimal @map("humidity_pct") @db.Decimal
  airPressureHpa Decimal @map("air_pressure_hpa") @db.Decimal
  zCorrectionValue Decimal @map("z_correction_value") @db.Decimal(6,4)
  zSourceVersion String @map("z_source_version") @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  @@map("lab_dimensions")
}
model CalibrationSession {
  asset Asset @relation(fields: [assetId,customerId,rangeThresholdId], references: [id,customerId,rangeThresholdId], onDelete: NoAction, onUpdate: NoAction, map: "fk_session_asset")
  lab LabDimension @relation(fields: [labDimensionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator User @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  volumes CalibrationVolumeResult[]
  lots CalibrationLot[]
  damages AssetDamage[]
  certificates AssetCertification[]
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId String @map("asset_id") @db.Uuid
  customerId String @map("customer_id") @db.Uuid
  rangeThresholdId String @map("range_threshold_id") @db.Uuid
  labDimensionId String @map("lab_dimension_id") @db.Uuid
  sessionNo Int @default(1) @map("session_no") @db.SmallInt
  status SessionStatus @default(in_progress)
  processDate DateTime @map("process_date") @db.Date
  nextCalibrationMonths Int @map("next_calibration_months") @db.SmallInt
  dueDate DateTime @map("due_date") @db.Date
  reminderDate DateTime @map("reminder_date") @db.Date
  startTime DateTime @default(now()) @map("start_time") @db.Timestamptz
  endTime DateTime? @map("end_time") @db.Timestamptz
  oneDispensingPerChannel Boolean @default(false) @map("one_dispensing_per_channel")
  deviceIp String? @map("device_ip") @db.Inet
  entryLocation String? @map("entry_location") @db.VarChar(200)
  inaccuracyStatus ResultStatus @default(pending) @map("inaccuracy_status")
  imprecisionStatus ResultStatus @default(pending) @map("imprecision_status")
  finalStatus ResultStatus @default(pending) @map("final_status")
  createdBy String @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  @@unique([assetId,sessionNo], map: "uq_session_number")
  @@unique([id,assetId], map: "uq_session_asset")
  @@unique([id,assetId,customerId], map: "uq_session_customer")
  @@index([assetId], map: "ix_sessions_asset")
  @@index([customerId,processDate], map: "ix_sessions_customer_date")
  @@index([dueDate], map: "ix_sessions_due")
  @@map("calibration_sessions")
}
model CalibrationVolumeResult {
  session CalibrationSession @relation(fields: [calibrationSessionId,assetId], references: [id,assetId], onDelete: NoAction, onUpdate: NoAction, map: "fk_volume_session")
  limit RangeThresholdLimit @relation(fields: [rangeThresholdLimitId,nominalVolumeUl], references: [id,nominalVolumeUl], onDelete: NoAction, onUpdate: NoAction, map: "fk_volume_limit")
  nominalLots CalibrationLot[] @relation("LotVolume")
  ancestryLots CalibrationLot[] @relation("LotVolumeAncestry")
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  calibrationSessionId String @map("calibration_session_id") @db.Uuid
  assetId String @map("asset_id") @db.Uuid
  rangeThresholdLimitId String @map("range_threshold_limit_id") @db.Uuid
  nominalVolumeUl Decimal @map("nominal_volume_ul") @db.Decimal
  inaccuracyLimitPct Decimal @map("inaccuracy_limit_pct") @db.Decimal
  imprecisionLimitPct Decimal @map("imprecision_limit_pct") @db.Decimal
  readingCount Int? @map("reading_count") @db.SmallInt
  meanVolumeUl Decimal? @map("mean_volume_ul") @db.Decimal
  stdDevUl Decimal? @map("std_dev_ul") @db.Decimal
  inaccuracyActualPct Decimal? @map("inaccuracy_actual_pct") @db.Decimal
  imprecisionActualPct Decimal? @map("imprecision_actual_pct") @db.Decimal
  inaccuracyResult ResultStatus @default(pending) @map("inaccuracy_result")
  imprecisionResult ResultStatus @default(pending) @map("imprecision_result")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  @@unique([calibrationSessionId,nominalVolumeUl], map: "uq_volume_session")
  @@unique([id,nominalVolumeUl], map: "uq_volume_nominal")
  @@unique([id,calibrationSessionId,assetId], map: "uq_volume_ancestry")
  @@index([calibrationSessionId], map: "ix_volume_session")
  @@map("calibration_volume_results")
}
model CalibrationLot {
  session CalibrationSession @relation(fields: [calibrationSessionId,assetId], references: [id,assetId], onDelete: NoAction, onUpdate: NoAction, map: "fk_lot_session")
  volume CalibrationVolumeResult @relation("LotVolume", fields: [calibrationVolumeResultId,nominalVolumeUl], references: [id,nominalVolumeUl], onDelete: NoAction, onUpdate: NoAction, map: "fk_lot_volume")
  volumeAncestry CalibrationVolumeResult @relation("LotVolumeAncestry", fields: [calibrationVolumeResultId,calibrationSessionId,assetId], references: [id,calibrationSessionId,assetId], onDelete: NoAction, onUpdate: NoAction, map: "fk_lot_volume_ancestry")
  readings CalibrationReading[]
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  calibrationVolumeResultId String @map("calibration_volume_result_id") @db.Uuid
  calibrationSessionId String @map("calibration_session_id") @db.Uuid
  assetId String @map("asset_id") @db.Uuid
  nominalVolumeUl Decimal @map("nominal_volume_ul") @db.Decimal
  lotNo Int @map("lot_no") @db.SmallInt
  channelNo Int? @map("channel_no") @db.SmallInt
  meanVolumeUl Decimal? @map("mean_volume_ul") @db.Decimal
  stdDevUl Decimal? @map("std_dev_ul") @db.Decimal
  inaccuracyActualPct Decimal? @map("inaccuracy_actual_pct") @db.Decimal
  imprecisionActualPct Decimal? @map("imprecision_actual_pct") @db.Decimal
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  @@unique([calibrationSessionId,lotNo], map: "uq_lot_number")
  @@unique([id,calibrationSessionId,assetId], map: "uq_lot_ancestry")
  @@index([calibrationSessionId], map: "ix_lots_session")
  @@index([assetId], map: "ix_lots_asset")
  @@map("calibration_lots")
}
model CalibrationReading {
  lot CalibrationLot @relation(fields: [calibrationLotId,calibrationSessionId,assetId], references: [id,calibrationSessionId,assetId], onDelete: NoAction, onUpdate: NoAction, map: "fk_reading_lot")
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  calibrationLotId String @map("calibration_lot_id") @db.Uuid
  calibrationSessionId String @map("calibration_session_id") @db.Uuid
  assetId String @map("asset_id") @db.Uuid
  readingNo Int @map("reading_no") @db.SmallInt
  massG Decimal @map("mass_g") @db.Decimal
  volumeUl Decimal @map("volume_ul") @db.Decimal
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  @@unique([calibrationLotId,readingNo], map: "uq_reading_number")
  @@index([calibrationLotId], map: "ix_readings_lot")
  @@index([assetId], map: "ix_readings_asset")
  @@map("calibration_readings")
}
model AssetDamage {
  asset Asset @relation(fields: [assetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  session CalibrationSession? @relation(fields: [calibrationSessionId,assetId], references: [id,assetId], onDelete: NoAction, onUpdate: NoAction, map: "fk_damage_session")
  creator User @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId String @map("asset_id") @db.Uuid
  calibrationSessionId String? @map("calibration_session_id") @db.Uuid
  observationNotes String @map("observation_notes")
  damagedPartName String @map("damaged_part_name") @db.VarChar(150)
  partReplaced Boolean @default(false) @map("part_replaced")
  replacedPartSerialNumber String? @map("replaced_part_serial_number") @db.VarChar(100)
  partCost Decimal? @map("part_cost") @db.Decimal(12,2)
  createdBy String @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  @@map("asset_damages")
}
model AssetCertification {
  session CalibrationSession @relation(fields: [calibrationSessionId,assetId,customerId], references: [id,assetId,customerId], onDelete: NoAction, onUpdate: NoAction, map: "fk_certificate_session")
  generator User @relation("CertificateGenerator", fields: [generatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  voider User? @relation("CertificateVoider", fields: [voidedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  assetId String @map("asset_id") @db.Uuid
  customerId String @map("customer_id") @db.Uuid
  calibrationSessionId String @map("calibration_session_id") @db.Uuid
  storageKey String @map("storage_key") @db.VarChar(500)
  sha256 String @db.Char(64)
  templateVersion String @map("template_version") @db.VarChar(30)
  generatedBy String @map("generated_by") @db.Uuid
  generatedAt DateTime @default(now()) @map("generated_at") @db.Timestamptz
  voidedAt DateTime? @map("voided_at") @db.Timestamptz
  voidedBy String? @map("voided_by") @db.Uuid
  voidReason String? @map("void_reason")
  idempotencyKey String @unique @map("idempotency_key") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  @@map("asset_certifications")
}
model AuditLog {
  actor User @relation(fields: [actorUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String @map("actor_user_id") @db.Uuid
  action String @db.VarChar(80)
  entityType String @map("entity_type") @db.VarChar(80)
  entityId String @map("entity_id") @db.Uuid
  beforeData Json? @map("before_data")
  afterData Json? @map("after_data")
  requestId String @map("request_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz
  @@index([entityType,entityId], map: "ix_audit_entity")
  @@map("audit_logs")
}